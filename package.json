{
  "name": "cleanroom-law",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:seed:dev": "npm run db:generate && node scripts/seed-dev.mjs",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test lib/parsing/*.test.ts server/authority/*.test.ts server/draft/*.test.ts server/matters/*.test.ts server/research/*.test.ts server/shared/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.5.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "prisma": "^7.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.2"
  }
}
