generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MatterStatus {
  setup
  researching
  verifying_authorities
  outlining
  drafting
  reviewing
  completed
}

enum ResearchSourceType {
  case_citation
  snippet
  note
  link
  proposition
}

enum ResearchItemStatus {
  new
  processed
  abandoned
}

enum AuthorityType {
  case_law
  statute
  regulation
  rule
  secondary_source
  other
}

enum ExistenceStatus {
  pass
  ambiguous
  fail_not_found
}

enum RetrievalStatus {
  pass
  fail_no_text
}

enum PinpointType {
  paragraphs
  pages
  none
}

enum SpeakerClassification {
  court_holding
  dicta
  quoted_authority
  party_submission
  procedural_history
  background_fact
  unknown
}

enum FitStatus {
  supports
  supports_narrower_only
  partial_support
  does_not_support
  misleading_if_isolated
}

enum RiskLevel {
  low
  medium
  high
}

enum VerificationStatus {
  not_started
  intake_passed
  provenance_reviewed
  fit_reviewed
  verified
  verified_with_warning
  blocked
  invalidated
}

enum AuthorityStatus {
  candidate
  eligible
  blocked
  invalidated
}

enum OutlineNodeType {
  issue
  rule
  analysis
  counterargument
  conclusion
}

enum OutlineNodeStatus {
  draft
  ready
  blocked
}

enum TaintStatus {
  clean
  suspect
  tainted
}

enum DraftSectionStatus {
  draft
  verified
  invalidated
}

enum ClaimSupportLinkStatus {
  verified
  warning
  blocked
}

enum DefectSeverity {
  critical
  major
  minor
}

enum ArtifactType {
  proposition
  outline_node
  paragraph
  section
  memo
  authority
}

enum StageDetected {
  intake
  provenance_fit_review
  outlining
  drafting
  claim_verification
  final_sweep
}

enum RestartScope {
  none
  authority_only
  proposition
  outline_node
  section
}

enum DefectStatus {
  open
  pending_human
  resolved
  waived
  reopened
}

enum CheckpointStage {
  research
  authority_clean
  outline_clean
  section_clean
}

enum CheckpointStatus {
  clean
  superseded
}

model Matter {
  id               String         @id @default(cuid())
  title            String
  courseOrContext  String?        @map("course_or_context")
  assignmentType   String?        @map("assignment_type")
  mainIssue        String?        @map("main_issue")
  objective        String?
  status           MatterStatus   @default(setup)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  researchItems    ResearchItem[]
  authorities      Authority[]
  outlineNodes     OutlineNode[]
  draftSections    DraftSection[]
  defects          Defect[]
  checkpoints      Checkpoint[]

  @@map("matters")
}

model ResearchItem {
  id                      String             @id @default(cuid())
  matterId                String             @map("matter_id")
  rawText                 String             @map("raw_text")
  sourceType              ResearchSourceType @map("source_type")
  candidateAuthorityNames Json?              @map("candidate_authority_names")
  notes                   String?
  status                  ResearchItemStatus @default(new)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  matter                  Matter             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorityLinks          AuthorityResearchItem[]

  @@index([matterId])
  @@index([matterId, status])
  @@index([createdAt])
  @@map("research_items")
}

model Authority {
  id                      String                @id @default(cuid())
  matterId                String                @map("matter_id")
  authorityType           AuthorityType         @default(case_law) @map("authority_type")
  citedName               String                @map("cited_name")
  normalizedName          String?               @map("normalized_name")
  jurisdiction            String?
  court                   String?
  date                    DateTime?
  sourceDatabase          String?               @map("source_database")
  existenceStatus         ExistenceStatus       @default(ambiguous) @map("existence_status")
  retrievalStatus         RetrievalStatus       @default(fail_no_text) @map("retrieval_status")
  pinpointType            PinpointType          @default(none) @map("pinpoint_type")
  excerptText             String?               @map("excerpt_text")
  excerptLocation         String?               @map("excerpt_location")
  speakerClassification   SpeakerClassification @default(unknown) @map("speaker_classification")
  propositionUnderReview  String?               @map("proposition_under_review")
  fitStatus               FitStatus?            @map("fit_status")
  riskLevel               RiskLevel?            @map("risk_level")
  verificationStatus      VerificationStatus    @default(not_started) @map("verification_status")
  status                  AuthorityStatus       @default(candidate)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  matter                  Matter                @relation(fields: [matterId], references: [id], onDelete: Cascade)
  claimSupportLinks       ClaimSupportLink[]
  defects                 Defect[]
  outlineNodeLinks        OutlineNodeAuthority[]
  researchItemLinks       AuthorityResearchItem[]

  @@index([matterId])
  @@index([status])
  @@index([verificationStatus])
  @@index([matterId, status])
  @@index([matterId, verificationStatus])
  @@index([matterId, updatedAt])
  @@map("authorities")
}

model OutlineNode {
  id                String                 @id @default(cuid())
  matterId          String                 @map("matter_id")
  parentId          String?                @map("parent_id")
  title             String
  nodeType          OutlineNodeType        @map("node_type")
  proposition       String?
  orderIndex        Int?                   @map("order_index")
  status            OutlineNodeStatus      @default(draft)
  taintStatus       TaintStatus            @default(clean) @map("taint_status")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  matter            Matter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  parent            OutlineNode?           @relation("OutlineNodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          OutlineNode[]          @relation("OutlineNodeTree")
  draftSections     DraftSection[]
  authorityLinks    OutlineNodeAuthority[]

  @@index([matterId])
  @@index([parentId])
  @@index([status])
  @@index([matterId, status])
  @@map("outline_nodes")
}

model OutlineNodeAuthority {
  outlineNodeId String     @map("outline_node_id")
  authorityId   String     @map("authority_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  outlineNode   OutlineNode @relation(fields: [outlineNodeId], references: [id], onDelete: Cascade)
  authority     Authority   @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  @@id([outlineNodeId, authorityId])
  @@index([authorityId])
  @@map("outline_node_authorities")
}

model DraftSection {
  id                String             @id @default(cuid())
  matterId          String             @map("matter_id")
  outlineNodeId     String             @map("outline_node_id")
  text              String
  status            DraftSectionStatus @default(draft)
  taintStatus       TaintStatus        @default(clean) @map("taint_status")
  checkpointParent  String?            @map("checkpoint_parent")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  matter            Matter             @relation(fields: [matterId], references: [id], onDelete: Cascade)
  outlineNode       OutlineNode        @relation(fields: [outlineNodeId], references: [id], onDelete: Cascade)
  checkpoint        Checkpoint?        @relation(fields: [checkpointParent], references: [id], onDelete: SetNull)
  claimSupportLinks ClaimSupportLink[]

  @@index([matterId])
  @@index([outlineNodeId])
  @@index([checkpointParent])
  @@index([matterId, taintStatus])
  @@map("draft_sections")
}

model ClaimSupportLink {
  id                    String                @id @default(cuid())
  draftSectionId        String                @map("draft_section_id")
  claimText             String                @map("claim_text")
  claimLocation         String?               @map("claim_location")
  authorityId           String                @map("authority_id")
  excerptText           String                @map("excerpt_text")
  excerptLocation       String?               @map("excerpt_location")
  speakerClassification SpeakerClassification @default(unknown) @map("speaker_classification")
  fitStatus             FitStatus             @map("fit_status")
  verificationSummary   String?               @map("verification_summary")
  status                ClaimSupportLinkStatus
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  draftSection          DraftSection          @relation(fields: [draftSectionId], references: [id], onDelete: Cascade)
  authority             Authority             @relation(fields: [authorityId], references: [id], onDelete: Restrict)

  @@index([draftSectionId])
  @@index([authorityId])
  @@map("claim_support_links")
}

model Defect {
  id                      String         @id @default(cuid())
  matterId                String         @map("matter_id")
  authorityId             String?        @map("authority_id")
  artifactType            ArtifactType   @map("artifact_type")
  artifactId              String         @map("artifact_id")
  defectType              String         @map("defect_type")
  severity                DefectSeverity
  stageDetected           StageDetected  @map("stage_detected")
  description             String
  requiredAction          String?        @map("required_action")
  restartScopeRecommended RestartScope   @map("restart_scope_recommended")
  restartScopeChosen      RestartScope?  @map("restart_scope_chosen")
  status                  DefectStatus   @default(open)
  resolutionNote          String?        @map("resolution_note")
  discoveredBy            String?        @map("discovered_by")
  resolvedBy              String?        @map("resolved_by")
  reopenCount             Int            @default(0) @map("reopen_count")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  matter                  Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authority               Authority?     @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  @@index([matterId])
  @@index([authorityId])
  @@index([artifactType, artifactId])
  @@index([severity, status])
  @@index([matterId, status])
  @@index([matterId, severity])
  @@map("defects")
}

model AuthorityResearchItem {
  id             String       @id @default(cuid())
  authorityId    String       @map("authority_id")
  researchItemId String       @map("research_item_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  authority      Authority    @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  researchItem   ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  @@unique([authorityId, researchItemId])
  @@index([authorityId])
  @@index([researchItemId])
  @@map("authority_research_items")
}

model Checkpoint {
  id            String           @id @default(cuid())
  matterId      String           @map("matter_id")
  stage         CheckpointStage
  status        CheckpointStatus @default(clean)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  matter        Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  draftSections DraftSection[]

  @@index([matterId])
  @@index([stage, status])
  @@map("checkpoints")
}
